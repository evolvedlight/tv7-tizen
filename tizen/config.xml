<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://init7.net/Init7TV" version="1.0.0" viewmodes="maximized">
    <tizen:application id="Init7TVApp.Init7TV" package="Init7TVApp" required_version="3.0"/>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <icon src="icon.png"/>
    <name>Init7 TV</name>
    <description>Native Init7 TV7 Live Player &amp; EPG for Samsung Smart TV (QN90AA)</description>
    <author href="https://www.init7.net">Init7 TV Tizen Client</author>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'self' data: blob: filesystem: 'unsafe-inline' 'unsafe-eval'; style-src * 'self' 'unsafe-inline'; script-src * 'self' 'unsafe-inline' 'unsafe-eval'; media-src * data: blob:; img-src * data: blob:; connect-src *;</tizen:content-security-policy>
    <tizen:service id="Init7TVApp.UdpxyService" auto-restart="true" on-boot="false">
        <tizen:content src="service/udpxy-service.js"/>
        <tizen:name>Init7UdpxyService</tizen:name>
        <tizen:description>Built-in On-TV UDP Multicast to HTTP MPEG-TS Proxy</tizen:description>
    </tizen:service>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.display"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-saver="disable" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
